# Copy to .env. Every external dependency has a best-of-breed and a Microsoft implementation behind one switch.

# ---- LLM: gemini (Google AI Studio / Vertex AI) or foundry (Azure AI Foundry / Azure OpenAI); auto = whichever is configured
LLM_PROVIDER=auto
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_DEPLOYMENT_PRO=gpt-5
AZURE_DEPLOYMENT_FLASH=gpt-5-mini
AZURE_DEPLOYMENT_LITE=gpt-5-nano
AZURE_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# ---- OCR for scans: tesseract (local) or document_intelligence (Azure AI Document Intelligence); the vision escalation applies to both
OCR_PROVIDER=auto
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---- Documents: local folder (demo) or sharepoint (Microsoft Graph delta sync; Entra ID app with Sites.Read.All)
DOCUMENT_SOURCE=local
DOCUMENT_SOURCE_PATH=./data/contracts
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Contracts

# ---- The database: Neo4j - one graph holds the contracts, clauses and names (vector + full-text index), the guideline,
# the name register from GLEIF, decisions and the audit log. Compose starts one (bolt://neo4j:7687 inside the stack,
# bolt://localhost:7687 from the host; browser on http://localhost:7474). AuraDB on Azure: neo4j+s://<id>.databases.neo4j.io.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contracts-graph
