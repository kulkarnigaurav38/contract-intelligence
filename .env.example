# Copy to .env. Every external dependency has a best-of-breed and a Microsoft implementation behind one switch.

# ---- LLM: gemini (Google AI Studio / Vertex AI) or foundry (Azure AI Foundry / Azure OpenAI); auto = whichever is configured
LLM_PROVIDER=auto
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_DEPLOYMENT_PRO=gpt-5
AZURE_DEPLOYMENT_FLASH=gpt-5-mini
AZURE_DEPLOYMENT_LITE=gpt-5-nano
AZURE_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# ---- OCR for scans: tesseract (local) or document_intelligence (Azure AI Document Intelligence); the vision escalation applies to both
OCR_PROVIDER=auto
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---- Documents: local folder (demo) or sharepoint (Microsoft Graph delta sync; Entra ID app with Sites.Read.All)
DOCUMENT_SOURCE=local
DOCUMENT_SOURCE_PATH=./data/contracts
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Contracts

DATABASE_URL=postgresql+psycopg://contracts:contracts@localhost:5432/contracts
